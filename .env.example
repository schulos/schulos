# Variablen für compose.yaml (nicht für die App – die liest schulos.env)
# App-Datenbankrolle „schulos“ (ohne Superuser-Recht)
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
# Wartungsrolle „postgres“ (Superuser, nur für schulosctl/Wartung; SEC-07) – anderes Passwort als oben
POSTGRES_ADMIN_PASSWORD=bitte-anderes-langes-zufaelliges-passwort
# Adresse, unter der SchulOS erreichbar ist
SCHULOS_DOMAIN=schulos.schule.local
# internal = eigene CA (nur Schulnetz) · E-Mail-Adresse = Let's Encrypt (öffentliche Domain)
SCHULOS_TLS=internal
# Außenzugang (INSTALLATION.md §5b): keiner = nur Schulnetz (Vorgabe) · oeffentliche-seiten = aus dem Internet nur
# Schulanmeldung, Impressum, Datenschutzhinweise · alles = ganz SchulOS
# SCHULOS_PUBLIC_ACCESS=keiner
# „Schulnetz“ in Caddy-Schreibweise, durch Leerzeichen getrennt (Vorgabe: alle privaten Adressbereiche)
# SCHULOS_INTERNAL_NETS=private_ranges
# hinter dem Proxy des Schulträgers: dessen Adresse(n) – nur von dort zählt X-Forwarded-For
# SCHULOS_TRUSTED_PROXIES=10.0.0.5
# Gerätezertifikate für Personal von außen (INSTALLATION.md §5c): Schul-CA starten mit `docker compose --profile geraete up -d`,
# danach an – Caddy nimmt dann Client-Zertifikate der Schul-CA an, die App verlangt sie (Vorgabe) von Lehrkräften/Personal
# SCHULOS_DEVICE_CERTS=aus
# SCHULOS_DEVICE_CA_PASSWORD=bitte-langes-zufaelliges-passwort-fuer-die-ca-schluessel
# SCHULOS_DEVICE_CA_PROVISIONER_PASSWORD=bitte-anderes-langes-zufaelliges-passwort
# Virenscan der Uploads (P4-72, optional): `docker compose --profile clamav up -d`, dann
# SCHULOS_CLAMAV=clamav:3310
# Angriffserkennung (SEC-15, optional, ohne Weitergabe an die Community-Liste): `docker compose --profile crowdsec up -d`, dann
# SCHULOS_CROWDSEC=1
# SCHULOS_CROWDSEC_URL=http://crowdsec:8080
# SCHULOS_CROWDSEC_BOUNCER_KEY=bitte-langer-zufaelliger-schluessel
# SCHULOS_HTTP_PORT=80
# SCHULOS_HTTPS_PORT=443
# bei abweichendem HTTPS-Port: z. B. ":8443"
# SCHULOS_PUBLIC_PORT=
# Images setzt `schulosctl update` (per Digest aus dem signierten Release-Manifest); ohne Angabe gelten die Vorgaben
# SCHULOS_IMAGE=schulos:dev
# SCHULOS_AGENT_IMAGE=schulos-agent:dev
# SCHULOS_CADDY_IMAGE=caddy:2
# SCHULOS_POSTGRES_IMAGE=postgres:18
# Update-Kanal: stabil (Vorgabe) oder beta
# SCHULOS_CHANNEL=stabil
