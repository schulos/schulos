# SchulOS-Live-System: Installer statt Anmeldung auf tty1 (Konsole mit Anmeldung auf tty2)
[Unit]
Description=SchulOS-Installer
After=systemd-user-sessions.service live-config.service systemd-udev-settle.service network-online.target systemd-resolved.service
Wants=systemd-udev-settle.service network-online.target systemd-resolved.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/local/lib/schulos/start-installer.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux LANG=C.UTF-8
Restart=no

[Install]
WantedBy=multi-user.target
