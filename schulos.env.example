# Konfiguration der App (INSTALLATION.md §8.1) – als schulos.env neben compose.yaml ablegen
# demo = Demo-Schule mit fiktiven Konten · production = leer bis auf das Admin-Konto. Später nicht änderbar.
SCHULOS_INSTANCE=demo

# Nur für production (beim ersten Start):
# SCHULOS_ADMIN_USERNAME=admin.it
# SCHULOS_ADMIN_FIRST_NAME=Vorname
# SCHULOS_ADMIN_LAST_NAME=Nachname
# Hash statt Klartext (Better-Auth scrypt, salt:key):
# SCHULOS_ADMIN_PASSWORD_HASH=
# SCHULOS_SCHOOL_NAME=Gesamtschule Musterstadt
# SCHULOS_SCHOOL_NUMBER=
# SCHULOS_SCHOOL_STATE=NW
# SCHULOS_SCHOOL_FORM=gesamtschule
# SCHULOS_TEMPLATES=1

# E-Mail (B-38): Testmail und Alarme (Backup überfällig/fehlgeschlagen, Prüfung fehlgeschlagen, Speicherplatz knapp,
# Update fehlgeschlagen) – je Ursache einmal, bei Fortbestehen täglich, „behoben“ wenn wieder in Ordnung. Keine Personendaten.
# SCHULOS_SMTP_HOST=smtp.schule.de
# SCHULOS_SMTP_PORT=587            (587 = STARTTLS Pflicht, 465 = TLS)
# SCHULOS_SMTP_USER=schulos@schule.de
# SCHULOS_SMTP_PASSWORD=…
# SCHULOS_SMTP_FROM=SchulOS <schulos@schule.de>
# SCHULOS_ALARM_TO=it@schule.de, schulleitung@schule.de
