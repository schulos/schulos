{
  "name": "schulos",
  "version": "0.6.0",
  "description": "SchulOS – quelloffene Schulplattform",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "prebuild": "node scripts/ensure-env.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack && npm run build -w @schulos/backup && npm run build -w @schulos/agent && npm run build -w @schulos/ctl && npm run build -w @schulos/installer",
    "start": "next start",
    "typecheck": "tsc --noEmit && npm run typecheck -w @schulos/backup && npm run typecheck -w @schulos/agent && npm run typecheck -w @schulos/ctl && npm run typecheck -w @schulos/installer",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run licenses && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx scripts/db-reset.ts",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run check && npm run build && npm run e2e && npm run e2e:backup",
    "licenses": "node scripts/licenses.mjs",
    "test:pg": "node scripts/test-pg.mjs",
    "e2e:backup": "node scripts/e2e-backup.mjs",
    "veroeffentlichen:pruefen": "tsx scripts/veroeffentlichen-pruefen.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schulos/schulos.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@excalidraw/excalidraw": "^0.18.1",
    "@schulos/ui": "0.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.3",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver": false,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "private": true,
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
