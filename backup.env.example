# Konfiguration des Backupservers (INSTALLATION.md §4, §8.1) – als backup.env neben compose.backup.yaml ablegen
# Admin-Konto beim ersten Start (Zwei-Faktor-Anmeldung wird beim ersten Login eingerichtet):
SCHULOS_ADMIN_USERNAME=admin.it
SCHULOS_ADMIN_FIRST_NAME=Vorname
SCHULOS_ADMIN_LAST_NAME=Nachname
# Hash statt Klartext (Better-Auth scrypt, salt:key) – Klartext wird nach dem Erststart aus dieser Datei entfernt:
# SCHULOS_ADMIN_PASSWORD_HASH=
SCHULOS_ADMIN_PASSWORD=bitte-langes-passwort-mit-mehreren-woertern
# Anzeigename des Servers
# SCHULOS_BACKUP_NAME=SchulOS Backup
# Kopplungscode vorgeben (Installer/CI): wird beim Start einmal übernommen, 24 h gültig
# SCHULOS_INITIAL_PAIRING_CODE=
# Aufbewahrung neu gekoppelter Instanzen täglich/wöchentlich/monatlich (Vorgabe 14/4/3, später je Instanz in der Web-UI);
# älteste Sicherung über 3 Monate nur mit Begründung (Löschkonzept, DATENSCHUTZ.md §3.3):
# SCHULOS_RETENTION=14/4/3
# SCHULOS_RETENTION_REASON=
# Wartung (Europe/Berlin): Aufräumen täglich, Prüfung wöchentlich, Test-Restore monatlich
# SCHULOS_PRUNE_TIME=14:00
# SCHULOS_CHECK_TIME=15:00
# SCHULOS_RESTORE_TEST_TIME=16:00

# Offsite-Kopie (B-37): täglich (SCHULOS_OFFSITE_TIME, Vorgabe 17:00) jede Instanz per rclone nach außer Haus, gleiche
# Aufbewahrung, mit dem Wiederherstellungsschlüssel der Schule lesbar. Ziel = <rclone-remote>:<pfad>, Remote über Umgebung:
# SCHULOS_OFFSITE=offsite:schulos
# SFTP (z. B. Hetzner Storage Box) – Host-Schlüssel immer prüfen (known_hosts aus `ssh-keyscan -p 23 <host>`):
# RCLONE_CONFIG_OFFSITE_TYPE=sftp
# RCLONE_CONFIG_OFFSITE_HOST=u123456.your-storagebox.de
# RCLONE_CONFIG_OFFSITE_PORT=23
# RCLONE_CONFIG_OFFSITE_USER=u123456
# RCLONE_CONFIG_OFFSITE_PASS=<Ausgabe von: rclone obscure 'passwort'>
# RCLONE_CONFIG_OFFSITE_KNOWN_HOSTS_FILE=/srv/schulos-backup/config/offsite_known_hosts
# RCLONE_CONFIG_OFFSITE_SHELL_TYPE=none
# S3:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=…
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=…
# Unveränderliche Kopie (SEC-11, INSTALLATION.md §4.3a): Schnappschüsse des Offsite-Ziels, die nur der Anbieter löschen kann
# (Storage Box: automatische Schnappschüsse + „ZFS-Ordner sichtbar“) – täglich geprüft, Alarm ab 48 h:
# SCHULOS_OFFSITE_SNAPSHOTS=offsite:.zfs/snapshot
# SCHULOS_OFFSITE_SNAPSHOT_MAX_HOURS=48

# E-Mail (B-38): Testmail und Alarme (Backup überfällig/fehlgeschlagen, Prüfung fehlgeschlagen, Speicherplatz knapp,
# Update fehlgeschlagen) – je Ursache einmal, bei Fortbestehen täglich, „behoben“ wenn wieder in Ordnung. Keine Personendaten.
# SCHULOS_SMTP_HOST=smtp.schule.de
# SCHULOS_SMTP_PORT=587            (587 = STARTTLS Pflicht, 465 = TLS)
# SCHULOS_SMTP_USER=schulos@schule.de
# SCHULOS_SMTP_PASSWORD=…
# SCHULOS_SMTP_FROM=SchulOS <schulos@schule.de>
# SCHULOS_ALARM_TO=it@schule.de, schulleitung@schule.de
