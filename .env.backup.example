# Variablen für compose.backup.yaml (nicht für die App – die liest backup.env)
# Adresse des Backupservers (das Hauptsystem koppelt und sichert dorthin)
SCHULOS_BACKUP_DOMAIN=backup.schule.local
# internal = eigene CA (das Hauptsystem pinnt sie) · E-Mail-Adresse = Let's Encrypt
SCHULOS_TLS=internal
# Passwort des Test-Postgres (nur Wegwerf-Datenbanken für den Test-Restore)
RESTORE_TEST_DB_PASSWORD=bitte-zufaellig
# SCHULOS_HTTP_PORT=80
# SCHULOS_HTTPS_PORT=443
# bei abweichendem HTTPS-Port: z. B. ":9443"
# SCHULOS_PUBLIC_PORT=
